{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "XRayStyler",
  "version": "1.1",
  "author": "tophf",
  "description": "Don't forget to enable the 'Developer mode' switch in chrome://extensions page!",
  "background": {
    "service_worker": "bg/bg.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "https://chromium-review.googlesource.com/",
    "https://bugs.chromium.org/",
    "https://*.chromestatus.com/"
  ]
}
